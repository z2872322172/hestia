# Hestia 后端环境变量示例
# 复制为 .env 后按本机实际情况修改；.env 不允许提交。
# 生产环境必须通过部署平台注入真实值，禁止把真实密钥写入仓库。

# ---------- MySQL ----------
# 如果宿主机 3306 已被旧容器占用，可改成 13306 后同步修改 DB_URL。
MYSQL_HOST_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/hestia?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=hestia
DB_PASSWORD=hestia-dev-secret

# ---------- Redis ----------
# 如果宿主机 6379 已被旧容器占用，可改成 16379。
REDIS_HOST_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- RocketMQ（gRPC 端点指向 Proxy） ----------
ROCKETMQ_NAMESRV_HOST_PORT=9876
ROCKETMQ_BROKER_HA_HOST_PORT=10909
ROCKETMQ_BROKER_HOST_PORT=10911
ROCKETMQ_PROXY_HOST_PORT=8081
ROCKETMQ_ENDPOINT=localhost:8081
ROCKETMQ_NAMESPACE=
ROCKETMQ_TECH_TOPIC=HK_TECH_EVENT
ROCKETMQ_TECH_CONSUMER_GROUP=GID_TECH_SMOKE

# ---------- MinIO ----------
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_BUCKET=housekeeping-dev-public
MINIO_PRIVATE_BUCKET=housekeeping-dev-private

# ---------- 高德地图（留空则使用 Mock Provider） ----------
MAP_PROVIDER=mock
AMAP_WEB_SERVICE_KEY=

# ---------- Web ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 安全密钥（生产必填，local/demo 有开发默认值） ----------
# JWT 签名密钥：至少 32 字节，生产缺失即启动失败
JWT_SECRET=
# 敏感字段加密密钥（人员证书编号）：AES-256-GCM 与 HMAC-SHA256 的实际密钥
# 都由它经 SHA-256 派生。留空时"提交证书编号"会被明确拒绝，不会退化成明文存储。
FIELD_KEY=

